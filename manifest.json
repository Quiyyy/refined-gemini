{
  "manifest_version": 3,
  "name": "Refined Gemini",
  "version": "1.3.0",
  "description": "1:1 对齐 ChatGPT 网页端视觉与排版基准：纯白/深灰画布、浅蓝用户气泡与 #0285FF 强调色、可调列表缩进比例（默认对齐 GPT）、紧凑代码块与无竖框表格。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Refined Gemini 设置",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "css": [
        "src/content.css"
      ],
      "js": [
        "src/defaults.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
