{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.10.4",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://github.com/Quiyyy/refined-gemini",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "toggle-styling": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Alt+Shift+G"
      },
      "description": "__MSG_cmdToggle__"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "css": [
        "src/content.css"
      ],
      "js": [
        "src/defaults.js",
        "src/startup.js",
        "src/content.js",
        "src/model-picker.js",
        "src/message-history.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://*.scf.usercontent.goog/*",
        "https://*.googleusercontent.com/*"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "css": [
        "src/sandbox.css"
      ],
      "js": [
        "src/defaults.js",
        "src/sandbox.js"
      ],
      "run_at": "document_start"
    }
  ]
}
