{
  "manifest_version": 3,
  "name": "Refined Gemini",
  "version": "1.0.1",
  "description": "1:1 对齐 ChatGPT 网页端视觉与排版基准：纯白/深灰画布、中英混排现代字体栈、无竖框左对齐表格、柔和圆角代码卡片与极简降噪布局。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Refined Gemini 设置",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "css": [
        "src/content.css"
      ],
      "js": [
        "src/defaults.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
